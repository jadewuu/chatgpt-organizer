{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["provider", "generatedAt", "taxonomyHash", "projects", "items", "planHash"],
  "additionalProperties": false,
  "properties": {
    "provider": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "taxonomyHash": { "type": "string", "minLength": 1 },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "exists", "createRequired", "proposedConversationCount"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "exists": { "type": "boolean" },
          "createRequired": { "type": "boolean" },
          "proposedConversationCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "conversationId",
          "project",
          "confidence",
          "reason",
          "suggestedAction",
          "title",
          "url",
          "currentProject",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "conversationId": { "type": "string", "minLength": 1 },
          "project": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "suggestedAction": { "enum": ["move", "archive", "keep"] },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "currentProject": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    },
    "planHash": { "type": "string", "minLength": 1 }
  }
}
